# Settiva — example environment configuration
# Copy this file to .env.local and replace placeholders.
# Do not commit .env.local or real credentials.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Only for authorized server routes; NEVER expose as NEXT_PUBLIC_*
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Network selection: 'testnet' (default) or 'mainnet' (requires server opt-in)
NEXT_PUBLIC_NEAR_DEFAULT_NETWORK=testnet

# NEAR RPC (server-side)
NEAR_TESTNET_RPC_URL=https://test.rpc.fastnear.com
NEAR_MAINNET_RPC_URL=https://free.rpc.fastnear.com

# Circle-native USDC contract allowlist (server-side)
# Validate official contract and ft_metadata before accepting payments.
NEAR_MAINNET_USDC_CONTRACT=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
NEAR_TESTNET_USDC_CONTRACT=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af

# Server-side mainnet payment safety gate. Do not enable without authorization.
ENABLE_MAINNET_PAYMENTS=false

# Default: verified Circle-listed testnet USDC.
NEAR_TESTNET_ASSET=circle-usdc
# Opt-in fallback only: set ASSET=test-token and all four values after verification.
NEAR_TESTNET_TEST_TOKEN_CONTRACT=
NEAR_TESTNET_TEST_TOKEN_NAME=
NEAR_TESTNET_TEST_TOKEN_SYMBOL=
NEAR_TESTNET_TEST_TOKEN_DECIMALS=
